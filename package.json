{
  "name": "nodriver-ts",
  "version": "0.3.0",
  "description": "Unofficial TypeScript redesign of nodriver: Chrome automation over CDP without Runtime.enable, with a native MCP server (Streamable HTTP and stdio)",
  "keywords": [
    "nodriver",
    "cdp",
    "chrome-devtools-protocol",
    "chrome",
    "chromium",
    "browser-automation",
    "mcp",
    "model-context-protocol",
    "ai-agent",
    "typescript"
  ],
  "homepage": "https://github.com/jaykwok/nodriver-ts#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaykwok/nodriver-ts.git"
  },
  "bugs": {
    "url": "https://github.com/jaykwok/nodriver-ts/issues"
  },
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/server.d.ts",
      "import": "./dist/mcp/server.js"
    },
    "./mcp/http": {
      "types": "./dist/mcp/http.d.ts",
      "import": "./dist/mcp/http.js"
    },
    "./mcp/socket": {
      "types": "./dist/mcp/socket.d.ts",
      "import": "./dist/mcp/socket.js"
    },
    "./mcp/compat": {
      "types": "./dist/mcp/compat.d.ts",
      "import": "./dist/mcp/compat.js"
    }
  },
  "bin": {
    "nodriver-mcp": "dist/mcp/cli.js"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/*.md",
    "docs/zh-CN/*.md"
  ],
  "scripts": {
    "mcp": "node src/mcp/cli.ts",
    "check": "tsc --noEmit && tsc -p tsconfig.test.json",
    "build": "tsc",
    "test": "node --test --test-timeout=60000 \"test/unit/*.test.ts\"",
    "test:integration": "node --test --test-concurrency=1 --test-timeout=60000 \"test/integration/*.test.ts\"",
    "test:audit": "node --test --test-concurrency=1 --test-timeout=60000 test/unit/execution-context.test.ts test/integration/runtime.test.ts",
    "test:mcp": "node --test --test-concurrency=1 --test-timeout=60000 test/unit/mcp-manager.test.ts test/unit/mcp-socket.test.ts test/unit/mcp-protocol.test.ts \"test/integration/mcp*.test.ts\"",
    "test:compat": "node --test --test-concurrency=1 --test-timeout=120000 test/integration/runtime.test.ts test/integration/environment.test.ts test/integration/churn.test.ts",
    "test:signals": "node --test --test-concurrency=1 --test-timeout=60000 test/integration/native-signals.test.ts",
    "test:all": "npm run check && npm test && npm run test:integration && npm run test:dist",
    "test:dist": "npm run build && node test/node-testing.mjs && node --test test/node-http.mjs && node test/node-smoke.mjs && node test/node-raw-session.mjs",
    "test:soak": "node benchmarks/soak.ts",
    "test:map": "node test/api-map.ts",
    "example": "node examples/basic.ts",
    "bench:mcp": "node benchmarks/mcp.ts",
    "bench:compare": "node benchmarks/compare.ts",
    "format": "prettier --write src test examples benchmarks \"*.md\" \"docs/*.md\" \"docs/zh-CN/*.md\"",
    "format:check": "prettier --check src test examples benchmarks \"*.md\" \"docs/*.md\" \"docs/zh-CN/*.md\"",
    "prepack": "npm run check && npm run build",
    "bench:audit": "node benchmarks/audit.ts",
    "bench:audit:manual": "node benchmarks/audit-manual.ts",
    "bench:handoff:manual": "node benchmarks/handoff-manual.ts",
    "bench:ax-subtree": "node benchmarks/ax-subtree.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "@types/node": "26.6.5",
    "@types/ws": "8.18.2",
    "devtools-protocol": "0.0.1718299",
    "proxy-chain": "3.0.1",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "expect": "30.5.2",
    "jest-mock": "30.5.2",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  }
}
